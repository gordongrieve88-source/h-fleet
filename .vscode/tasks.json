{
  // Auto-starts the dev server when the folder opens, so localhost:3002 is just
  // there. VS Code asks to allow it the first time — say yes, then forget it.
  // Next hot-reloads on save; you only need the other tasks occasionally.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev server (localhost:3002)",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "hfleet" },
      "problemMatcher": []
    },
    {
      "label": "Rebuild demo data (after a pull or schema change)",
      "detail": "prisma generate + migrate + reseed — wipes local board edits",
      "type": "shell",
      "command": "npm install && npm run setup",
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "hfleet" },
      "problemMatcher": []
    },
    {
      "label": "Checks before committing",
      "detail": "typecheck + lint + tests — the same three CI runs",
      "type": "shell",
      "command": "npm run typecheck && npm run lint && npm test",
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "hfleet" },
      "problemMatcher": []
    }
  ]
}
