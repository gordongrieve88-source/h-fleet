{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)"
    ]
  }
}
