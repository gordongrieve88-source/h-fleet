// ============================================================================
//  H-Fleet — Production Schema
// ----------------------------------------------------------------------------
//  Single source of truth for the database. Identical for the local demo and
//  Azure production — only the `provider` line and connection string differ.
//
//  Design notes:
//   - Structure is DATA (region → depot → truck), editable in the app — new
//     depots or trucks are added in Setup/admin screens, never in code.
//   - Public holidays live in a table (per-state), editable in Setup.
//   - Every write is recorded in AuditLog ("who did what, when").
//   - In-app Notification table drives the bell in the top bar.
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  // DEMO: "sqlite".  AZURE PRODUCTION: change to "sqlserver".
  provider = "sqlite"
}

// ============================================================================
//  REFERENCE / CONFIG
// ============================================================================

/// Leave categories (AL, PL, RDO, …). Colour drives the planner/board chips.
/// One editable list in Setup covers all driver leave + entitlements.
model LeaveType {
  code      String  @id
  name      String
  colorHex  String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  driverLeave        DriverLeave[]
  driverEntitlements DriverEntitlement[]
}

/// Public holidays, per state. states = "ALL" or a CSV like "NSW,VIC".
/// Editable in Setup — no hardcoded dates anywhere in the app.
model PublicHoliday {
  id     Int    @id @default(autoincrement())
  date   String // "YYYY-MM-DD"
  name   String
  states String @default("ALL")

  @@index([date])
}

// ============================================================================
//  IDENTITY  (what Microsoft Entra ID maps onto in production)
// ============================================================================

model AppUser {
  id            Int     @id @default(autoincrement())
  displayName   String
  email         String? @unique
  role          String  @default("STAFF") // STAFF / SUPERVISOR / MANAGER
  isActive      Boolean @default(true)
  entraObjectId String? @unique // null in demo; Entra object id in production

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]
  depotScopes   UserDepotScope[]
  /// Set when this account belongs to a driver (self-service on /me).
  driver        Driver?
}

/// Limits a SUPERVISOR to specific depots. No rows = unrestricted (scoping is
/// an opt-in restriction); MANAGER ignores scope entirely. Enforced in
/// lib/auth (requireEditForDepot) on every scoped write path.
model UserDepotScope {
  userId  Int
  depotId Int

  user  AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  depot Depot   @relation(fields: [depotId], references: [id], onDelete: Cascade)

  @@id([userId, depotId])
}

// ============================================================================
//  AUDIT + NOTIFICATIONS
// ============================================================================

/// Append-only record of every write: who, what, when, and a human summary.
/// userName is denormalised on purpose — the log must read cleanly even if
/// accounts are later renamed or removed.
model AuditLog {
  id       Int      @id @default(autoincrement())
  at       DateTime @default(now())
  userId   Int?
  userName String
  action   String // e.g. "fleet.assign", "fleet.leave.approve", "setup.holidayCreate"
  entity   String // e.g. "TruckAssignment", "DriverLeave"
  entityId Int?
  summary  String // human-readable one-liner shown in the Activity feed
  meta     String? // JSON blob for anything structured

  @@index([at])
  @@index([action])
}

/// In-app notifications — the bell in the top bar. Created by server actions
/// (leave decided, …); readAt marks them seen.
model Notification {
  id     Int       @id @default(autoincrement())
  userId Int
  at     DateTime  @default(now())
  kind   String // "leave" / "fleet" / "system"
  title  String
  body   String?
  href   String? // where clicking it goes
  readAt DateTime?

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// ============================================================================
//  INTEGRATIONS  (inbound feeds from other corporate systems)
// ----------------------------------------------------------------------------
//  H-Fleet consumes data it doesn't own — people/leave balances from the HR
//  system, vehicle actuals from telematics. Each connector is a provider
//  behind one interface (lib/integrations), chosen by configuration, so
//  swapping a sample provider for the real vendor is a config change.
// ============================================================================

/// One execution of a connector — the audit trail for automated data changes.
/// `isSample` is recorded permanently so demo runs can never be mistaken for
/// real vendor data after the fact.
model IntegrationRun {
  id         Int       @id @default(autoincrement())
  connector  String // "people" / "telematics"
  provider   String // "sample" / "csv" / "http"
  isSample   Boolean   @default(false)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("RUNNING") // RUNNING / OK / FAILED / PREVIEW
  summary    String    @default("")
  detail     String? // JSON: counts, errors, per-record notes
  dryRun     Boolean   @default(false)

  triggeredByUserId Int?

  @@index([connector, startedAt])
}

/// What a truck actually did on a day, observed by telematics — as opposed to
/// what the roster planned. Keyed like TruckAssignment so the two line up.
model TruckTelemetry {
  id          Int      @id @default(autoincrement())
  date        DateTime // UTC midnight; treated as a date
  truckId     String
  /// Observed first-movement / depot-departure time, "HH:MM" 24h.
  actualStart String?
  odometerKm  Float?
  engineHours Float?
  /// Vendor fault/DTC code seen that day, if any — feeds breakdown evidence.
  faultCode   String?
  source      String   @default("sample")
  isSample    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  truck Truck @relation(fields: [truckId], references: [id], onDelete: Cascade)

  @@unique([date, truckId])
  @@index([date])
}

// ============================================================================
//  FLEET  (metro driver/truck daily roster)
// ----------------------------------------------------------------------------
//  194 drivers and ~149 agitator trucks across 13 depots, replacing the
//  "HMA Metro Roster" spreadsheet. Data-driven structure (region → depot →
//  truck), every write audited, leave against the shared LeaveType list.
// ============================================================================

/// The operational unit the business dispatches by — "301 — NSW Conc" is the
/// group the Syncrotess roster is printed for, and the suffix fleet codes
/// carry (PLC2213-301). As the fleet grows past NSW, each state or business
/// unit gets its own group, and the whole app can be narrowed to one.
///
/// `state` is the jurisdiction the group operates in, which is what depot
/// credentials are scoped by; a group normally sits in exactly one.
model DispatchGroup {
  code      String  @id // "301"
  name      String // "NSW Conc"
  state     String  @default("NSW")
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  depots  Depot[]
  regions FleetRegion[]
}

/// Fleet operating regions (Projects, Metro East/West/Central). Regions
/// belong to a dispatch group — each group draws its own operating map, so
/// the depot editor only offers the regions of the group being assigned.
/// Null = legacy/unassigned, offered everywhere until it's claimed.
model FleetRegion {
  name              String  @id
  dispatchGroupCode String?
  sortOrder         Int     @default(0)
  isActive          Boolean @default(true)

  dispatchGroup DispatchGroup? @relation(fields: [dispatchGroupCode], references: [code], onDelete: SetNull)
  depots        Depot[]
}

/// A physical home base (Greenacre, Prestons, …). Drivers and trucks belong
/// to a depot; leave coverage is measured per depot.
model Depot {
  id         Int     @id @default(autoincrement())
  name       String  @unique
  regionName String
  /// Which state this depot physically sits in — the anchor for anything
  /// that varies by jurisdiction (credentials, public holidays). The fleet
  /// began as NSW-only, hence the default.
  state      String  @default("NSW")
  /// Which dispatch group runs this depot. Null until groups are set up.
  dispatchGroupCode String?
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)

  dispatchGroup    DispatchGroup?   @relation(fields: [dispatchGroupCode], references: [code], onDelete: SetNull)
  region           FleetRegion      @relation(fields: [regionName], references: [name])
  drivers          Driver[]
  trucks           Truck[]
  supervisorScopes UserDepotScope[]

  @@index([regionName])
}

model Driver {
  id         Int     @id @default(autoincrement())
  employeeNo String  @unique
  name       String
  depotId    Int
  workgroup  String  @default("") // free label from the data: LOD / Metro / Project …
  isActive   Boolean @default(true)
  /// The sign-in account this driver uses for self-service (/me). Null until
  /// linked; one account per driver. Set on the Drivers admin screen.
  appUserId  Int?    @unique

  depot         Depot               @relation(fields: [depotId], references: [id])
  appUser       AppUser?            @relation(fields: [appUserId], references: [id], onDelete: SetNull)
  leave         DriverLeave[]
  entitlements  DriverEntitlement[]
  defaultTrucks Truck[]             @relation("TruckDefaultDriver")
  assignments   TruckAssignment[]
  credentials   DriverCredential[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([depotId])
  @@index([isActive])
}

/// The fleet code IS the id (PCC2038, PLC2603 …) — it is how the business
/// refers to a truck everywhere. `region`/`block` are the board grouping
/// (where it operates), which can differ from its home depot.
model Truck {
  id              String  @id
  depotId         Int
  region          String
  block           String // board block label, e.g. "Greenacre Project"
  /// Vehicle function (Agitator, Tipper, …). Free data — values typed in
  /// admin appear in the board chips and wallboard breakdowns automatically.
  type            String  @default("Agitator")
  defaultDriverId Int?
  sortOrder       Int     @default(0)
  isActive        Boolean @default(true)

  depot         Depot             @relation(fields: [depotId], references: [id])
  defaultDriver Driver?           @relation("TruckDefaultDriver", fields: [defaultDriverId], references: [id], onDelete: SetNull)
  assignments   TruckAssignment[]
  telemetry     TruckTelemetry[]
  properties    TruckOnProperty[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([depotId])
  @@index([region])
}

/// The tick-box attributes a truck can carry — the allocation system's
/// property codes (Automatic Transmission, UHF Radio Fitted, PBS, …). The
/// catalog is reference data managed in Setup; each truck ticks its own on
/// Fleet → Trucks. The code is what the allocation system prints, so it is
/// the identity and can't be edited after the fact.
model TruckProperty {
  code      String  @id
  name      String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  trucks TruckOnProperty[]
}

model TruckOnProperty {
  id           Int    @id @default(autoincrement())
  truckId      String
  propertyCode String

  truck    Truck         @relation(fields: [truckId], references: [id], onDelete: Cascade)
  property TruckProperty @relation(fields: [propertyCode], references: [code], onDelete: Cascade)

  @@unique([truckId, propertyCode])
  @@index([propertyCode])
}

/// The saved daily board — one row per (date, truck). A date with no rows is
/// synthesised live from each truck's default driver ("roll forward"); the
/// first edit materialises the whole day so it becomes reportable history.
model TruckAssignment {
  id       Int      @id @default(autoincrement())
  date     DateTime // UTC midnight; treated as a date
  truckId  String
  status   String   @default("ON") // ON / ON-FTO / … / OFF-BD / OFF-ND (lib/wfm/fleet.ts)
  driverId Int?
  time     String?
  /// Where the truck works THIS day (from the Syncrotess Location column) —
  /// often its home plant, but trucks get lent across plants day by day.
  workLocation String?
  note     String?

  createdByUserId Int?
  updatedByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  truck  Truck   @relation(fields: [truckId], references: [id], onDelete: Cascade)
  driver Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@unique([date, truckId])
  @@index([date])
}

/// Driver leave — APPROVED blocks the board, PENDING sits in Approvals —
/// against the shared LeaveType list.
model DriverLeave {
  id              Int       @id @default(autoincrement())
  driverId        Int
  leaveTypeCode   String
  startDate       DateTime
  endDate         DateTime // inclusive
  status          String    @default("APPROVED") // APPROVED / PENDING / REJECTED
  notes           String?
  decisionNote    String?
  decidedByUserId Int?
  decidedAt       DateTime?

  createdByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  driver    Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeCode], references: [code])

  @@index([driverId, startDate])
  @@index([status])
}

/// Everything a driver can hold — editable in Setup like LeaveType.
///
/// Two kinds, because the fleet tracks two different things:
///   EXPIRY  — a dated ticket (HC licence, medical, site induction that
///             lapses). `severity` decides what an EXPIRED one does:
///             "BLOCK" refuses to roster the driver, "WARN" only flags.
///             `warnDays` is the expiring-soon window.
///   TICKBOX — a competency they either hold or don't (trained on a mix,
///             signed off on a truck type, inducted to a site). No date.
///
/// `category` groups them on the driver's profile ("Truck types", "Mixes",
/// "Site inductions") and is free data — a new grouping is just a new label.
///
/// `requiredForTruckType` is the enforceable one: set it to a Truck.type and
/// a driver who doesn't hold this credential cannot be rostered onto a truck
/// of that type. Site inductions stay informational because the board knows
/// which plant a truck works from, not which customer job it's sent to.
model CredentialType {
  code                 String  @id
  name                 String
  kind                 String  @default("EXPIRY") // EXPIRY / TICKBOX
  category             String  @default("Tickets & medicals")
  /// Where this credential applies: "ALL", or a CSV of states like
  /// "NSW,VIC" — same wire format as PublicHoliday.states. A driver only
  /// sees, and is only gated by, credentials that apply in their depot's
  /// state, so a NSW-only ticket never follows the fleet interstate.
  states               String  @default("ALL")
  severity             String  @default("WARN") // WARN / BLOCK
  warnDays             Int     @default(30)
  requiredForTruckType String?
  sortOrder            Int     @default(0)
  isActive             Boolean @default(true)

  credentials DriverCredential[]
}

/// One credential a driver holds — a licence, medical or induction, with an
/// optional reference number and expiry. Renewal = update the expiry (one
/// row per driver per type). Null expiresOn = never expires.
model DriverCredential {
  id        Int       @id @default(autoincrement())
  driverId  Int
  typeCode  String
  reference String?
  expiresOn DateTime? // UTC midnight; treated as a date
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type   CredentialType @relation(fields: [typeCode], references: [code])

  @@unique([driverId, typeCode])
  @@index([expiresOn])
}

/// Annual entitlement per driver/type/year — drives the AL balance shown in
/// the planner and reports. (H-Fleet never computes pay; this is roster info.)
model DriverEntitlement {
  id             Int   @id @default(autoincrement())
  driverId       Int
  leaveTypeCode  String
  year           Int
  entitledDays   Float @default(0)
  openingBalance Float @default(0)

  driver    Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeCode], references: [code])

  @@unique([driverId, leaveTypeCode, year])
}
