# ============================================================================
#  H-Fleet — stored configuration file (production)
# ----------------------------------------------------------------------------
#  Install as:   /etc/h-fleet/h-fleet.env      (root:hfleet, mode 0640)
#  Loaded by:    the systemd unit (EnvironmentFile=) — see h-fleet.service
#
#  SQL Server connection — the same details an ODBC record holds. Prisma
#  connects to SQL Server natively (TDS), so no ODBC driver or DSN needs to
#  be installed on the server; just fill these in.
# ============================================================================

# --- SQL Server connection --------------------------------------------------
DB_HOST=sqlserver.example.internal
DB_PORT=1433
DB_NAME=hfleet
DB_USER=hfleet_app
DB_PASSWORD=change-me
# Encrypt the connection (keep "true" unless the server can't do TLS).
DB_ENCRYPT=true
# Set "true" only for self-signed certs on an internal network.
DB_TRUST_SERVER_CERTIFICATE=false

# If the password contains ';' or '{', leave the DB_* fields unset and supply
# one full connection URL instead (see Prisma sqlserver escaping rules):
# DATABASE_URL=sqlserver://host:1433;database=hfleet;user=...;password={...};encrypt=true

# --- App --------------------------------------------------------------------
NODE_ENV=production
PORT=3002
