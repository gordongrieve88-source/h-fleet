# ============================================================================
#  H-Fleet — stored configuration file (production)
# ----------------------------------------------------------------------------
#  Install as:   /etc/h-fleet/h-fleet.env      (root:hfleet, mode 0640)
#  Loaded by:    the systemd unit (EnvironmentFile=) — see h-fleet.service
#
#  SQL Server connection — the same details an ODBC record holds. Prisma
#  connects to SQL Server natively (TDS), so no ODBC driver or DSN needs to
#  be installed on the server; just fill these in.
# ============================================================================

# --- SQL Server connection --------------------------------------------------
DB_HOST=sqlserver.example.internal
DB_PORT=1433
DB_NAME=hfleet
DB_USER=hfleet_app
DB_PASSWORD=change-me
# Encrypt the connection (keep "true" unless the server can't do TLS).
DB_ENCRYPT=true
# Set "true" only for self-signed certs on an internal network.
DB_TRUST_SERVER_CERTIFICATE=false

# If the password contains ';' or '{', leave the DB_* fields unset and supply
# one full connection URL instead (see Prisma sqlserver escaping rules):
# DATABASE_URL=sqlserver://host:1433;database=hfleet;user=...;password={...};encrypt=true

# --- App --------------------------------------------------------------------
NODE_ENV=production
PORT=3002

# --- Sign-in (Microsoft Entra ID) --------------------------------------------
# "demo" = the seeded role switcher (local only). "entra" = corporate SSO;
# every setting below this line is then required. Setup steps: deploy/README.md.
AUTH_MODE=entra

# Signs the session cookie. Generate once:  openssl rand -base64 48
SESSION_SECRET=change-me-openssl-rand-base64-48
# Hours before a session round-trips through Entra again (default 12).
SESSION_MAX_AGE_HOURS=12

# From the Entra app registration (Azure portal → App registrations):
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=change-me
# Must byte-for-byte match a Redirect URI on the app registration:
ENTRA_REDIRECT_URI=https://hfleet.example.internal/auth/callback

# Wallboard TVs can't do interactive SSO. Open
#   https://<host>/wallboard/fleet?key=<this value>
# on the TV once and it stays signed in (cookie). Rotate to cut TVs off.
# Generate:  openssl rand -hex 24     (leave unset to require normal sign-in)
WALLBOARD_TOKEN=change-me-openssl-rand-hex-24

# --- Inbound integrations ----------------------------------------------------
# Each connector picks a provider. "off" (the default) means H-Fleet talks to
# nothing. "sample" produces clearly-labelled demonstration data for showing
# the workflow without vendor access — never leave it on in production.
#
# People & leave balances (HR / Workday):  off | sample | csv | http
PEOPLE_PROVIDER=off
#   csv  — scheduled report drop onto a file share:
# WORKDAY_PEOPLE_CSV=/var/lib/h-fleet/feeds/people.csv
# WORKDAY_BALANCES_CSV=/var/lib/h-fleet/feeds/balances.csv
#   http — REST extract (see deploy/README for the expected JSON shape):
# WORKDAY_API_URL=https://hr.example.internal/api/hfleet
# WORKDAY_API_TOKEN=change-me
#
# Telematics actuals (EROAD / MTData / …):  off | sample | http
TELEMATICS_PROVIDER=off
# TELEMATICS_API_URL=https://telematics.example.com/api/v1
# TELEMATICS_API_TOKEN=change-me

# --- BI feed (Power BI etc.) -------------------------------------------------
# Read-only roster analytics at /api/bi/<dataset>, authenticated with this
# bearer token. LEAVE UNSET to keep the feed switched off (the default).
# Generate:  openssl rand -hex 32
# BI_API_TOKEN=
